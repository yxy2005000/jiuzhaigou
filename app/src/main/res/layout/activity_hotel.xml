<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    android:background="#F0F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 第一部分：高端酒店 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#ffffff"
            android:padding="20dp"
            android:layout_marginBottom="15dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/jiudian"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="高端酒店"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="紧邻景区入口，设施完善，观景条件优越，价位400—800元/晚。
推荐理由：24小时管家服务、景区VIP通道、观景露台、免费早餐。
周边配套：景区游客中心、特色餐饮街、大型停车场。"
                android:textSize="15sp"
                android:textColor="#666666"/>

            <Button
                android:id="@+id/btn_collect_high"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="收藏高端酒店"
                android:background="#4A90E2"
                android:textColor="#fff"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 第二部分：精品民宿 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#ffffff"
            android:padding="20dp"
            android:layout_marginBottom="15dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/jiudian1"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="精品民宿"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="藏式风格浓郁，环境安静，性价比高，价位200—400元/晚。
推荐理由：本地房东接待、特色藏式餐食、小院观景、免费景区攻略。
周边配套：民俗文化街、小型超市、景区接驳车点。"
                android:textSize="15sp"
                android:textColor="#666666"/>

            <Button
                android:id="@+id/btn_collect_boutique"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="收藏精品民宿"
                android:background="#4A90E2"
                android:textColor="#fff"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 第三部分：经济型客栈 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#ffffff"
            android:padding="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/jiudian2"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="经济型客栈"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="适合学生及自助游客，交通便利，干净舒适，价位100—200元/晚。
推荐理由：性价比高、公共休息区、行李寄存、景区拼车服务。
周边配套：公交站、小吃街、便利店、自助洗衣房。"
                android:textSize="15sp"
                android:textColor="#666666"/>

            <Button
                android:id="@+id/btn_collect_economy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="收藏经济型客栈"
                android:background="#4A90E2"
                android:textColor="#fff"
                android:textSize="16sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>